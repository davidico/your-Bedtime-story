{
  // Un solo Worker: sirve el export estático de Next.js (carpeta /out) y la API /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-bedtime-story",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Solo /api/* despierta al Worker; el resto lo sirven los assets directamente.
    "run_worker_first": ["/api/*"]
  },
  // Crear con `npx wrangler kv namespace create FIGURES` y pegar aquí el id.
  // `wrangler dev` simula el KV en local, así que el marcador sirve para probar.
  "kv_namespaces": [{ "binding": "FIGURES", "id": "3c60fac640234820bdc346995b346096" }],
  "ratelimits": [
    { "name": "FIGURE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  // IA de dibujo por defecto: Workers AI (gratis, sin clave). Si existe el secreto ANTHROPIC_API_KEY, manda Claude.
  // AI_MODEL (var opcional) cambia el modelo de Workers AI (por defecto @cf/openai/gpt-oss-120b).
  "ai": { "binding": "AI" },
  // Secretos (no van aquí): `wrangler secret put FAMILY_CODES` y, si se quiere Claude, `wrangler secret put ANTHROPIC_API_KEY`.
  "vars": { "DAILY_FIGURE_CAP": "300", "ALLOWED_ORIGINS": "https://your-bedtime-story.davidcueva-dico.workers.dev" },
  "env": {
    // `npx wrangler deploy --env preview`: KV, límites y secretos propios (código de familia distinto).
    // kv_namespaces, ratelimits, vars y ai no se heredan: hay que repetirlos en cada entorno.
    "preview": {
      "ai": { "binding": "AI" },
      "kv_namespaces": [{ "binding": "FIGURES", "id": "9a84529c85f7419a862e1a78cfb058fe" }],
      "ratelimits": [
        { "name": "FIGURE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": { "DAILY_FIGURE_CAP": "300", "ALLOWED_ORIGINS": "" }
    }
  }
}
